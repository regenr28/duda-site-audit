{
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 120
    },
    "api/capture.js": {
      "maxDuration": 120,
      "memory": 1769,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/dudasites?op=sweep",
      "schedule": "50 21 * * *"
    }
  ]
}
