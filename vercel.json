{
  "outputDirectory": "public",
  "functions": {
    "api/capture.js": {
      "maxDuration": 120,
      "memory": 1769,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "api/watch.js": {
      "maxDuration": 120,
      "includeFiles": "public/engine.js"
    },
    "api/dudasites.js": {
      "maxDuration": 120,
      "includeFiles": "public/engine.js"
    },
    "api/store.js": {
      "maxDuration": 120,
      "includeFiles": "public/engine.js"
    },
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/((?!api/live).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/live",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/dudasites?op=sweep",
      "schedule": "50 21 * * *"
    },
    {
      "path": "/api/watch?op=cron",
      "schedule": "20 22 * * *"
    },
    {
      "path": "/api/watch?op=tick",
      "schedule": "*/10 * * * *"
    }
  ]
}
